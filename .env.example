# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Optional Supabase browser client config for production auth.
# Publishable keys are safe for browser use, but they cannot run migrations or server writes by themselves.
VITE_REQUIRE_AUTH=false
VITE_QA_AUTH_ENABLED=false
VITE_SUPABASE_URL=https://cjcsinixideeqiwzdvna.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production backend storage. Keep this server-side only; never expose it to Vite/frontend code.
# Use a Supabase pooled Postgres connection string when deploying FastAPI.
NEURALOPS_DATABASE_URL=
NEURALOPS_POSTGRES_SCHEMA=neuralops_private
NEURALOPS_POSTGRES_TABLE=records
NEURALOPS_ENVIRONMENT=local
NEURALOPS_WORKSPACE_ID=local-workspace
NEURALOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEURALOPS_DELIVERY_SEND_ENABLED=false
NEURALOPS_GITHUB_SEND_ENABLED=false
GITHUB_TOKEN=
NEURALOPS_QA_AUTH_TOKEN=
NEURALOPS_QA_WORKSPACE_ID=deployed-qa-workspace

# Set to true for public deployment. Backend validates Supabase JWT bearer tokens.
NEURALOPS_AUTH_REQUIRED=false
SUPABASE_URL=https://cjcsinixideeqiwzdvna.supabase.co
# Optional for legacy HS256 projects. Prefer Supabase JWKS/asymmetric signing when available.
SUPABASE_JWT_SECRET=

# Optional live model providers. Leave empty to use the deterministic local runtime.
# Preferred product path: add provider connections from Settings -> AI Provider Gateway.
# Env vars are useful for servers and CI where secrets are injected by the platform.
NEURALOPS_SECRET_KEY=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gateway and OpenAI-compatible providers.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_MODEL=openai/gpt-4o-mini

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Local/private OpenAI-compatible servers.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

VLLM_ENABLED=false
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

LM_STUDIO_ENABLED=false
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Generic OpenAI-compatible fallback provider.
NEURALOPS_API_KEY=
NEURALOPS_PROVIDER_URL=
NEURALOPS_MODEL=
